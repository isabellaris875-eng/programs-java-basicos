import java.util.Scanner;

public class VerificarEdad {

    // Función para verificar si puede votar
    public static boolean puedeVotar(int edad) {

        if (edad >= 18) {
            return true;
        } else {
            return false;
        }
    }

    public static void main(String[] args) {

        Scanner entrada = new Scanner(System.in);

        // Pedir edad
        System.out.print("Ingresa tu edad: ");
        int edad = entrada.nextInt();

        // Llamar función
        boolean resultado = puedeVotar(edad);

        // Mostrar resultado
        if (resultado) {
            System.out.println("\nLa persona SÍ puede votar.");
        } else {
            System.out.println("\nLa persona NO puede votar.");
        }

        entrada.close();
    }
}
